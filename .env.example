# --- Required ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Your personal chat id (send /start to @userinfobot to find it).
# Messages from any other chat are ignored.
ALLOWED_CHAT_ID=

# --- Optional ---
# Claude model used for parsing, Q&A and phrasing summaries.
CLAUDE_MODEL=claude-sonnet-5-5
# Thinking effort: low | medium | high. Leave empty to use the model default.
CLAUDE_EFFORT=low
# Ask the API to re-run a request on a fallback model if the primary declines it.
CLAUDE_REFUSAL_FALLBACK=true
# Timezone for "today", the 21:00 daily summary and the Friday 12:00 weekly one.
TZ=Asia/Jerusalem
# SQLite file. On Railway / Fly.io point this at a mounted volume, e.g. /data/bisbot.db
DB_PATH=data/bisbot.db
# The meal plan (prompt context) and its machine-readable targets.
MENU_PATH=menu.md
MENU_TARGETS_PATH=menu_targets.json
LOG_LEVEL=INFO
